<odoo>
    <record id="view_rivetit_sso_integration_list" model="ir.ui.view">
        <field name="name">rivetit.sso.integration.list</field>
        <field name="model">rivetit.sso.integration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="client_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_rivetit_sso_integration_form" model="ir.ui.view">
        <field name="name">rivetit.sso.integration.form</field>
        <field name="model">rivetit.sso.integration</field>
        <field name="arch" type="xml">
            <form string="RivetIT SSO integration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="client_id"/>
                        <field name="issuer_url"/>
                        <field name="company_id"/>
                        <field name="portal_start_url"/>
                        <field name="callback_url"/>
                    </group>
                    <group string="Integration secret">
                        <field name="has_secret" invisible="1"/>
                        <div colspan="2">
                            <span class="badge text-bg-success" invisible="not has_secret">
                                A secret is configured
                            </span>
                            <span class="badge text-bg-danger" invisible="has_secret">
                                No secret set - sign-in will fail
                            </span>
                        </div>
                        <field name="secret" password="True"
                               placeholder="Paste the same secret you entered in RivetIT (32+ characters)"/>
                        <div colspan="2">
                            <button name="action_generate_secret" type="object"
                                    string="Generate a secret"
                                    class="btn btn-secondary btn-sm"
                                    confirm="Generate a new secret? Any secret currently configured in RivetIT will stop working until you paste the new one there."/>
                        </div>
                    </group>
                    <p class="text-muted">
                        Only the SHA-256 hash of the secret is stored; the raw value is never
                        written to the database and cannot be read back. Leave the field blank
                        to keep the existing secret. Enable <b>Active</b> once the secret is set
                        and RivetIT holds the same value.
                    </p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rivetit_sso_integrations" model="ir.actions.act_window">
        <field name="name">RivetIT SSO integrations</field>
        <field name="res_model">rivetit.sso.integration</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_rivetit_sso_integrations" name="RivetIT SSO"
              parent="base.menu_administration" action="action_rivetit_sso_integrations"
              groups="base.group_system" sequence="95"/>
</odoo>
