# RivetIT nginx vhost template
#
# Consumed by: deploy/install.sh, via `envsubst`, written to
#   /etc/nginx/sites-available/${DOMAIN}.conf and symlinked into sites-enabled.
#
# Variables install.sh must export before substitution:
#   DOMAIN            e.g. rivetit.example.com  (used verbatim, no scheme/port)
#   APP_ROOT          absolute path to the app's webroot, e.g. /var/www/rivetit.example.com
#   PHP_SOCK           bare socket path, e.g. /run/php/php8.5-fpm.sock (NOT prefixed with "unix:" -
#                      this template adds that prefix itself)
#   SSL_CERT_PATH      e.g. /etc/ssl/certs/rivetit.example.com.crt (or a certbot fullchain.pem path)
#   SSL_CERT_KEY_PATH  e.g. /etc/ssl/private/rivetit.example.com.key (or a certbot privkey.pem path)
#
# IMPORTANT envsubst gotcha: this file is full of nginx's own $variables
# ($request_uri, $server_name, $uri, $host, $binary_remote_addr, ...). Do NOT
# run plain `envsubst < template`, which substitutes every $NAME that happens
# to match an exported shell variable and could mangle an nginx variable by
# accident. Always pass an explicit restrict-list of only the placeholders
# above, e.g.:
#   envsubst '${DOMAIN} ${APP_ROOT} ${PHP_SOCK} ${SSL_CERT_PATH} ${SSL_CERT_KEY_PATH}' \
#       < nginx-vhost.conf.template > /etc/nginx/sites-available/${DOMAIN}.conf
#
# PROXY MODE vs DIRECT-TLS MODE:
# This one template covers both ways an instance can be reached:
#   - direct-TLS mode: this box terminates TLS itself (e.g. via certbot) and is
#     reachable on 443 directly.
#   - proxy mode: an external reverse proxy (not on this box) terminates the
#     public TLS endpoint and forwards to this box on a backend port (8443)
#     using a self-signed backend cert - matches the real mw-itflow.foleyit.com
#     pattern already running in production.
# install.sh decides which mode applies and edits the substituted output
# in place with sed/awk (nginx has no `if` worth trusting for this - config
# structure, not runtime logic, is what differs between the two modes):
#   - `# __PROXY_MODE_BLOCK__` is a sentinel line: install.sh should grep for
#     it first and fail loudly if it's missing, as a safety check that the
#     template version it's consuming still supports the strip logic below
#     (protects against a future template edit that silently drops the
#     markers this script depends on).
#   - Every line between a `# BEGIN PROXY-MODE ONLY` and the next
#     `# END PROXY-MODE ONLY` (inclusive of the marker lines themselves) is
#     PROXY-MODE-only content. In direct-TLS mode, install.sh must delete all
#     such ranges. In proxy mode, install.sh must delete only the two marker
#     comment lines themselves and keep the content between them.
#   - Symmetrically, `# BEGIN DIRECT-TLS ONLY` / `# END DIRECT-TLS ONLY`
#     delimits direct-TLS-only content (HSTS - see rationale below). In proxy
#     mode, delete the whole range; in direct-TLS mode, keep the content and
#     drop just the two marker lines.
#   FIRST strip THIS documentation header, then apply the per-mode sed. The
#   header is not optional housekeeping: the four lines above mention the marker
#   strings as inline documentation, and sed's /start/,/end/ range does not test
#   the end pattern against the line that opened the range - so run directly on
#   the un-stripped file, the "Every line between a ..." bullet above opens a
#   range that only closes at the REAL end marker far below and takes the
#   `server {` line with it. Reproduced 2026-09-08: the proxy-mode output lost
#   its opening `server {` and nginx -t said "location directive is not allowed
#   here". install.sh already does the strip (see the comment above its own
#   copy of these two lines); anything rendering this by hand must too.
#     header strip:    sed -i '1,/^server {/{ /^server {/!d }' file
#     proxy mode:      sed -i '/# BEGIN DIRECT-TLS ONLY/,/# END DIRECT-TLS ONLY/d; /# __PROXY_MODE_BLOCK__/d; /# BEGIN PROXY-MODE ONLY/d; /# END PROXY-MODE ONLY/d' file
#     direct-TLS mode:  sed -i '/# BEGIN PROXY-MODE ONLY/,/# END PROXY-MODE ONLY/d; /# __PROXY_MODE_BLOCK__/d; /# BEGIN DIRECT-TLS ONLY/d; /# END DIRECT-TLS ONLY/d' file
#   With the strip applied first, both modes render with the /uploads/kb/ deny
#   intact and pass `nginx -t` (measured 2026-09-08, nginx 1.24.0).
#
# Rate limiting: `limit_req_zone` MUST live in nginx's http{} context, which
# this file (a server{} block pair) is not - install.sh must additionally
# drop the single line
#   limit_req_zone $binary_remote_addr zone=itflow_login:10m rate=5r/m;
# into a top-level file under /etc/nginx/conf.d/ (e.g.
# /etc/nginx/conf.d/itflow-rate-limit.conf) once per box, shared by every
# RivetIT vhost on it - defining the same zone name twice across included
# files is an nginx startup error, so install.sh should check for an
# existing definition before writing a second one when adding a second
# company's instance to a box that already has one.
#
# Location/security rules below reproduce (inline, so this template is
# self-contained and portable to a box that doesn't have it)
# /etc/nginx/snippets/itflow-locations.conf as deployed on the real
# itflow.foleyit.com family of vhosts, translating the app's .htaccess rules
# (nginx does not read .htaccess) plus new defense-in-depth response headers
# nginx sets nowhere today (includes/header.php and login.php already set
# the same values in PHP - this duplicates them so every response, including
# static assets and pre-PHP error pages, gets them too).

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Always redirect to HTTPS. Use $server_name (the literal domain string
    # above), never $host/$http_host - in proxy mode a hop in the reverse
    # proxy chain could forward a Host header carrying the backend port, and
    # $server_name is immune to that.
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    # __PROXY_MODE_BLOCK__
    # BEGIN PROXY-MODE ONLY
    listen 8443 ssl http2;                 # reverse proxy chain connects here
    listen [::]:8443 ssl http2;
    # END PROXY-MODE ONLY
    server_name ${DOMAIN};

    root ${APP_ROOT};
    index index.php index.html;
    client_max_body_size 500M;

    # BEGIN PROXY-MODE ONLY
    # Behind a reverse proxy on the backend port above - keep nginx's own
    # redirects (e.g. /admin -> /admin/) RELATIVE so the backend port/host
    # never leaks into a URL an end user's browser sees.
    absolute_redirect off;
    port_in_redirect off;
    server_name_in_redirect off;
    # END PROXY-MODE ONLY

    ssl_certificate ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_CERT_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # BEGIN DIRECT-TLS ONLY
    # HSTS is only safe to set here when THIS box terminates the public TLS
    # endpoint. In proxy mode the upstream reverse proxy owns that endpoint
    # and its HSTS policy; setting it here in proxy mode would only apply to
    # the internal :8443 hop, not the public URL, which is misleading at
    # best and could pin the wrong max-age at worst.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # END DIRECT-TLS ONLY

    # Defense-in-depth: includes/header.php and login.php already set these
    # exact values in PHP for every page they render. Setting identical
    # values here too costs nothing and also covers static assets, 404s, and
    # anything served before PHP ever runs.
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Root .htaccess: block .git, .github, and direct config.php access
    location ~ ^/(\.git|\.github|config\.php) {
        return 404;
    }

    # Every dotfile (.env, .env.example, .gitignore, ...) and the deployment
    # tooling/docs shipped in this same checkout - none is meant to be served.
    # /restore/ is where the Docker Compose flow drops an encrypted backup and
    # its passphrase; denied here too so the two vhosts stay in step (see
    # docker/nginx.conf). /.well-known/ stays reachable for ACME/certbot.
    location ^~ /.well-known/ {
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }

    location ^~ /restore/ {
        deny all;
    }

    location ~ ^/(deploy|docker|docs)/ {
        deny all;
    }

    # uploads/.htaccess: never execute uploaded files as scripts
    location ~ ^/uploads/.*\.(php|phtml|phar|phps|cgi|pl|sh)$ {
        deny all;
    }

    # KB media is the one part of /uploads/ that must never be served directly.
    #
    # Everything else under /uploads/ is addressed by a URL the application
    # already decided you may see (an avatar, the company logo, a document
    # image), but a KB attachment or a DOCX/PDF-imported inline image is
    # department-scoped content whose on-disk name is md5(contents) + 2 random
    # characters - guessable by anyone who already holds the same document, and
    # permanent once leaked, because nothing about the path expires when a
    # user's access does. Denying the prefix is what makes the authenticated
    # endpoints the ONLY door: agent/kb_media.php, client/kb_media.php and
    # agent/kb_article_attachment.php each re-derive the whole permission chain
    # from the database per request and then stream the bytes with PHP
    # (fpassthru), so nothing here needs X-Accel-Redirect and "internal" would
    # buy nothing over a flat deny.
    #
    # SCOPED TO /uploads/kb/ ON PURPOSE. A deny on all of /uploads/ would break
    # every avatar, company logo, client-file thumbnail and document image -
    # they are <img> subresources with no serve endpoint in front of them. This
    # prefix is the only one the KB serve endpoints cover.
    #
    # A SEPARATE TOP-LEVEL PREFIX, not a nested block: nginx picks the LONGEST
    # matching prefix location, so "/uploads/kb/..." lands here and never in the
    # "^~ /uploads/" block below, which is exactly the intent. The script-deny
    # does not need repeating inside it the way it does below - "deny all"
    # already refuses every method and every extension.
    #
    # DEPLOY ORDER. This deny is the LAST of the three steps, and applying it
    # early is the one way to break working images: (1) deploy the code, so the
    # three serve endpoints exist; (2) run the database update to 2.6.78, which
    # rewrites stored KB URLs onto those endpoints and refuses to run if step 1
    # has not happened; (3) add this block and reload. Between (2) and (3)
    # everything works through both doors; after (3) only the authenticated one
    # is open.
    location ^~ /uploads/kb/ {
        deny all;
    }

    # Training content media. INTERNAL: reachable only via X-Accel-Redirect from
    # agent/training_media.php, which authorizes every request from the database
    # first. nginx then serves the bytes (sendfile, Range/206 for iOS video) so a
    # 95 MB MP4 never holds a PHP-FPM worker. Evidence is never served.
    #
    # A separate "^~" prefix, longer than "^~ /uploads/", so /uploads/training/...
    # lands here and never in the attachment-forcing block below. The script
    # deny is repeated as a nested location for the same reason it is there.
    # add_header does not inherit into a location that declares its own, so
    # the server-level headers are repeated.
    location ^~ /uploads/training/ {
        internal;
        location ~ \.(php|phtml|phar|phps|cgi|pl|sh)$ { deny all; }
        location ^~ /uploads/training/evidence/ { deny all; }
        types {
            application/pdf pdf; image/jpeg jpg; image/png png; image/webp webp; image/gif gif; video/mp4 mp4;
            text/plain txt; text/csv csv; text/vtt vtt;
            application/vnd.openxmlformats-officedocument.wordprocessingml.document docx;
            application/vnd.openxmlformats-officedocument.spreadsheetml.sheet xlsx;
            application/vnd.openxmlformats-officedocument.presentationml.presentation pptx;
        }
        default_type application/octet-stream;
        # BEGIN DIRECT-TLS ONLY
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # END DIRECT-TLS ONLY
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }

    # The Windows kiosk-mode start URL /kiosk/?d=<token>: the token is a device credential, so this
    # hop is answered here - never logged, never reaching PHP - with a redirect to the fragment form,
    # which no server sees (the page adopts it by POST). kiosk/index.php does the same 302 where this
    # rule is missing. Anything else at /kiosk/ falls through to the directory index as before.
    location = /kiosk/ {
        absolute_redirect off;   # a relative Location: right behind a TLS-terminating proxy too
        if ($args ~ "^d=([A-Za-z0-9_-]{43})$") {
            access_log off;
            return 302 /kiosk/#d=$1;
        }
    }

    # Training kiosk (/kiosk/, P3 spec §7.11). A public path OUTSIDE /agent/, so the edge's
    # Turnstile challenge on /agent/* never interrupts employees (plan A19). Every kiosk PHP
    # request authenticates itself (device cookie + PIN session). The generic \.php$ location
    # would otherwise execute the include files; "^~" beats that regex.
    location ^~ /kiosk/includes/ {
        deny all;
    }

    # Kiosk PHP: the pages send their own CSP and Referrer-Policy (no-referrer, or
    # strict-origin-when-cross-origin on the video page), so there is NO server-level
    # Referrer-Policy here. add_header does not inherit into a location that declares its own,
    # so HSTS and the other server-level headers are repeated. Must stay above the generic
    # "location ~ \.php$" (nginx takes the first matching regex).
    location ~ ^/kiosk/.*\.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
        # BEGIN DIRECT-TLS ONLY
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # END DIRECT-TLS ONLY
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Everything under /uploads/ is attacker-supplied content served from the
    # app's own origin, so the browser must never RENDER it: an uploaded .html
    # or .svg opened directly runs its script same-origin against whatever
    # session the viewer has. Content-Disposition forces save-to-disk on a
    # top-level navigation, and nosniff stops a mistyped response being
    # re-sniffed into HTML. This is defence for direct navigation only - it
    # does not affect <img>/<link rel=icon> subresource loads, so the company
    # logo, user avatars and client file thumbnails still display normally.
    #
    # "^~" is required (a plain prefix would lose to the regex locations above
    # and the headers would never be set) but "^~" is also the trap: it tells
    # nginx to STOP at this prefix and skip regex evaluation entirely, which
    # silently disables the top-level script-deny regex above for every URI
    # under /uploads/. That is why the deny is repeated as a NESTED location
    # here, inside this prefix's own location tree, where it is still
    # evaluated. Keep BOTH copies, and never add a fastcgi_pass under this
    # prefix the way "^~ /plugins/" does - that block needs PHP, this one must
    # never have it or uploaded .php files become executable.
    location ^~ /uploads/ {
        location ~ ^/uploads/.*\.(php|phtml|phar|phps|cgi|pl|sh)$ {
            deny all;
        }

        # add_header does not merge across levels: declaring ANY add_header in
        # a location discards the entire inherited set from server{}, so the
        # server-level headers must be repeated verbatim here or /uploads/
        # responses would quietly lose X-Frame-Options, Referrer-Policy and
        # Permissions-Policy. No Cache-Control: user content is replaced in
        # place and must always be re-fetched.
        # BEGIN DIRECT-TLS ONLY
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # END DIRECT-TLS ONLY
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Disposition "attachment" always;
    }

    # cron/.htaccess + scripts/.htaccess: these run via CLI only, never over HTTP
    location ~ ^/(cron|scripts)/.*\.php$ {
        deny all;
    }

    # backups/.htaccess, config/.htaccess, plugins/TCPDF/tools/.htaccess: deny all
    location ^~ /backups/ {
        deny all;
    }

    location ^~ /config/ {
        deny all;
    }

    location ^~ /plugins/TCPDF/tools/ {
        deny all;
    }

    # The legacy per-resource leaf scripts (api/v1/<resource>/<action>.php)
    # must never be reachable over HTTP. They predate the router, each one
    # re-implements its own auth, and reaching one directly skips every
    # permission and client-scope gate api/v1/index.php applies - see the
    # comment at the top of api/v1/credentials/read.php, which only exists
    # because nginx serves that file. The plain-prefix "location /api/v1/"
    # below does NOT stop this: a prefix match that is not "^~" still lets
    # nginx go on to evaluate regex locations, and the generic
    # "location ~ \.php$" then wins and hands the file to PHP-FPM.
    #
    # ORDERING IS THE FIX. nginx tries regex locations in the order they are
    # written in the file and takes the FIRST that matches, so this deny only
    # works because it sits ABOVE "location ~ \.php$" - keep it there. It
    # cannot shadow the router: "location = /api/v1/index.php" is an exact
    # match and exact matches beat every regex regardless of order, and
    # /api/v1/index.php has no second path segment so it never matches this
    # pattern anyway. Clean URLs (/api/v1/tickets/42/chat) carry no ".php"
    # suffix and are untouched. Same rule already live on
    # beta-itflow.foleyit.com.
    location ~ ^/api/v1/.+/.+\.php$ { deny all; return 403; }

    # api/v1/.htaccess and api/v2/.htaccess: clean-URL front controllers
    location /api/v1/ {
        try_files $uri /api/v1/index.php?$query_string;
    }

    location /api/v2/ {
        try_files $uri /api/v2/index.php?$query_string;
    }

    # Defense in depth: never serve dotfiles (.htaccess, etc.)
    location ~ /\.ht {
        deny all;
    }

    # Brute-force protection on the two unauthenticated entry points that
    # accept a password. Must come before the generic \.php$ block below,
    # same ordering rule as the SSE and api/v1/index.php blocks - nginx
    # picks the first matching regex/exact location, not the most specific
    # one. Requires the sibling limit_req_zone line in /etc/nginx/conf.d/
    # (see the header comment above) or nginx will fail to start.
    location ~ ^/(login|setup)\.php$ {
        limit_req zone=itflow_login burst=3 nodelay;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
    }

    # SSE: nginx buffers the entire fastcgi response by default, which holds
    # back Server-Sent Events until the script exits (the app's
    # X-Accel-Buffering header has no effect on fastcgi_pass, only
    # proxy_pass). Matches both agent/sse_ticket_stream.php and
    # client/sse_ticket_stream.php. Must come before the generic \.php$
    # block since nginx picks the first matching regex location.
    location ~ /sse_ticket_stream\.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
        fastcgi_buffering off;
    }

    # API v1 front controller - exact match takes priority over the regex
    # \.php$ block below, so fastcgi_buffering off applies here too
    # (required for SSE-shaped endpoints served through the API, e.g. a
    # ticket chat or notifications stream reached via /api/v1/...).
    location = /api/v1/index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
        fastcgi_buffering off;
    }

    # The Admin API documentation page embeds this public reference on the
    # same origin. Route it through the API front controller while overriding
    # the server-wide DENY frame header for this one page only.
    location = /api/v1/docs {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/api/v1/index.php;
        fastcgi_param SCRIPT_NAME /api/v1/index.php;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
        # BEGIN DIRECT-TLS ONLY
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # END DIRECT-TLS ONLY
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        fastcgi_hide_header X-Frame-Options;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

    # The Odoo authorization callback carries a one-time code in its URL.
    # Application audit logs record safe reason categories instead.
    location = /client/login_odoo.php {
        access_log off;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
    }

    # MCP Streamable HTTP and OAuth protected-resource metadata. The PHP
    # endpoint returns 404 until a dedicated OAuth issuer is configured.
    location = /mcp {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/mcp_server/index.php;
        fastcgi_param SCRIPT_NAME /mcp_server/index.php;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_buffering off;
    }

    location = /.well-known/oauth-protected-resource {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/mcp_server/index.php;
        fastcgi_param SCRIPT_NAME /mcp_server/index.php;
        fastcgi_pass unix:${PHP_SOCK};
    }

    # The one agent page the app frames itself (in-window video check). The page sends
    # CSP frame-ancestors 'self' instead of X-Frame-Options (same pattern as kb_embed_serve.php).
    # An exact match, so it wins over the generic PHP location below regardless of order;
    # same fastcgi lines. The server-level headers are repeated WITHOUT X-Frame-Options
    # (declaring add_header here drops the inherited set, which is the point).
    location = /agent/training_video_frame.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
        # BEGIN DIRECT-TLS ONLY
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        # END DIRECT-TLS ONLY
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # PHP-FPM
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCK};
        fastcgi_read_timeout 300s;
    }

    # Static asset caching. /plugins (vendor libs), /fonts, and /css (already
    # filemtime-versioned via ?v= in includes/footer.php) are safe for a
    # long, immutable cache - they either never change in place or change URL
    # when they do. /js is NOT included here: some first-party scripts under
    # it are NOT ?v=-versioned, so immutable caching could serve a stale copy
    # after an edit - it gets a short revalidate-friendly max-age instead.
    # /uploads deliberately gets no Cache-Control (a replaced file must be
    # re-fetched); its own block above sets security headers only.
    location ^~ /plugins/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /css/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /js/ {
        add_header Cache-Control "public, max-age=3600";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
