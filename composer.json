{
    "name": "rivetit/rivetit",
    "description": "RivetIT is a free and open-source internal IT operations platform for managing service requests, users, devices, documentation, automation, integrations, and employee training from one centralized system.",
    "type": "project",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/TheTractorHacker/RivetIT",
    "support": {
        "issues": "https://github.com/TheTractorHacker/RivetIT/issues",
        "source": "https://github.com/TheTractorHacker/RivetIT",
        "docs": "https://github.com/TheTractorHacker/RivetIT/tree/main/docs",
        "security": "https://github.com/TheTractorHacker/RivetIT/security/advisories/new"
    },
    "require": {
        "predis/predis": "^3.5",
        "aws/aws-sdk-php": "^3.395",
        "firebase/php-jwt": "^7.2",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8",
        "psr/simple-cache": "^3.0",
        "rivet/rivet-core": "^0.20"
    },
    "autoload": {
        "psr-4": {
            "ITFlow\\": "src/"
        }
    },
    "repositories": [{
        "name": "rivet-core",
        "type": "vcs",
        "url": "https://github.com/TheTractorHacker/rivet-core",
        "no-api": true
    }]
}
